#!/usr/bin/env bash
# campus-login：校园网认证直连脚本（南开 netauth）
# 源：EurekaimerOS/modules/home/applications/web.nix
set -euo pipefail

if ! desktop=$(xdg-settings get default-web-browser 2>/dev/null) ||
   [[ $desktop != zen.desktop ]] || ! command -v zen-browser >/dev/null; then
  echo '无法为当前默认浏览器创建直连隔离窗口' >&2
  exit 1
fi

unset http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
umask 077
profile=$(mktemp -d -- "${TMPDIR:-/tmp}/campus-login.XXXXXXXX")
trap 'rm -rf -- "$profile"' EXIT
printf '%s\n' 'user_pref("network.proxy.type", 0);' > "$profile/user.js"
zen-browser --no-remote --profile "$profile" --new-window 'https://netauth.nankai.edu.cn/'
