# Center the visual mark when moving between lines.
autocenter_visual_scroll 1

# >>> sioyek-ecdict >>>
# Warm local ECDICT lookup and shortcut panel.
new_command _ecdict /usr/bin/gdbus call --session --dest io.github.sioyek.ecdict --object-path /io/github/sioyek/ecdict --method io.github.sioyek.ecdict.Lookup %{selected_text}
new_command _ecdict_settings /home/eurekaimer/.local/share/sioyek-ecdict/runtime/bin/sioyek-ecdict settings
# <<< sioyek-ecdict <<<
