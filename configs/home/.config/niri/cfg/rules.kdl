    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
        draw-border-with-background false
        // Let stacked columns shrink below client size hints so every border stays visible.
        min-width 0
        min-height 0
    }

    // Files opened from Thunar/Nautilus become a readable side column.
    window-rule {
        match app-id=r#"^(markdown-neovim|imv)$"#
        default-column-width { proportion 0.5; }
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    window-rule {
        match app-id=r#"^niri-hotkeys-help$"#
        open-floating true
        default-column-width { fixed 980; }
        default-window-height { fixed 1100; }
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
