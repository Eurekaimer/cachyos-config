[Desktop Entry]
Name=wechat
Name[zh_CN]=微信
# Wayland main-window IME workaround; emoji search remains an upstream limitation.
# https://github.com/Kraftland/arch-wechat-packaging/discussions/1
Exec=/usr/bin/env QT_IM_MODULE=text-input-unstable-v3 XMODIFIERS=@im=fcitx /opt/wechat/wechat %U
StartupNotify=true
Terminal=false
Icon=/usr/share/icons/hicolor/256x256/apps/wechat.png
Type=Application
Categories=Utility;
Comment=Wechat Desktop
Comment[zh_CN]=微信桌面版
