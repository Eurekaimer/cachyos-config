// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "unnecessary_code_fade": 0.3,
  "buffer_font_size": 20.0,
  "buffer_line_height": "comfortable",
  "cursor_shape": "bar",
  "markdown_preview": {
    "font_family": "LXGWWenKaiMono Nerd Font"
  },
  "agent_buffer_font_size": 22.0,
  "agent_buffer_font_family": "LXGW WenKai Mono",
  "ui_font_weight": 500.0,
  "ui_font_family": "Monaspace Radon",
  "ui_font_fallbacks": [
    "Noto Sans CJK SC",
    "sans-serif"
  ],
  "window_title_format": "${projectName}${separator}${fileName}",
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "terminal": {
    "font_family": "LXGWWenKaiMono Nerd Font",
    "font_fallbacks": [
      "monospace"
    ]
  },
  "minimap": {
    "show": "always"
  },
  "buffer_font_fallbacks": [
    "LXGW WenKai Mono",
    "monospace"
  ],
  "buffer_font_family": "LXGWWenKaiMono Nerd Font",
  "soft_wrap_indent": "same",
  "soft_wrap": "editor_width",
  "base_keymap": "Zed",
  "ui_font_size": 22.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}
