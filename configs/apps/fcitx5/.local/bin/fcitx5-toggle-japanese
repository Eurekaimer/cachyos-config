#!/usr/bin/env bash
set -Eeuo pipefail

# Switch language groups silently; keep desktop notifications for actual events.
current_group=$(fcitx5-remote -q)
case "$current_group" in
    Default)
        next_group=Japanese
        ;;
    Japanese)
        next_group=Default
        ;;
    *)
        next_group=Default
        ;;
esac

fcitx5-remote -g "$next_group"
