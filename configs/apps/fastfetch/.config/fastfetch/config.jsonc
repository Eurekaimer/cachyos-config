{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/eurekaimer/Pictures/Wallpapers/Bingo.jpg",
    "type": "kitty",
    "width": 24,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 1
    }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "key": { "width": 18 },
    "color": {
      "keys": "cyan",
      "title": "blue",
      "separator": "bright_black"
    }
  },
  "modules": [
    "title",
    "separator",
    "break",

    { "type": "custom", "key": " ", "format": "╭─ 󰌢  HARDWARE", "outputColor": "blue" },
    { "type": "board", "key": "├─ 󰇅  Board" },
    { "type": "bios", "key": "├─ 󰓙  Firmware", "format": "{version} ({type})" },
    { "type": "cpu", "key": "├─ 󰻠  CPU", "format": "Intel CPU ({cores-physical}C / {cores-logical}T) @ {freq-max}" },
    { "type": "gpu", "key": "├─ 󰍛  GPU" },
    { "type": "memory", "key": "├─ 󰘚  Memory", "percent": { "type": ["num", "bar"] } },
    { "type": "swap", "key": "├─ 󰓡  Swap", "percent": { "type": ["num", "bar"] } },
    { "type": "physicaldisk", "key": "├─ 󰋊  Storage", "hideVirtual": true, "format": "{name} ({physical-type}, {interconnect}) - {size}" },
    { "type": "display", "key": "├─ 󰍹  Display" },
    { "type": "disk", "key": "╰─ 󰋊  Root FS", "folders": ["/"], "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}" },

    "break",
    { "type": "custom", "key": " ", "format": "╭─ 󰘧  SOFTWARE", "outputColor": "magenta" },
    { "type": "os", "key": "├─   OS" },
    { "type": "kernel", "key": "├─ 󰒋  Kernel" },
    { "type": "packages", "key": "├─ 󰏖  Packages" },
    { "type": "shell", "key": "├─   Shell" },
    { "type": "wm", "key": "├─   WM" },
    { "type": "theme", "key": "├─ 󰉼  Theme" },
    { "type": "terminal", "key": "├─ 󰆍  Terminal" },
    { "type": "locale", "key": "├─ 󰗊  Locale" },
    { "type": "datetime", "key": "├─ 󰃭  Date" },
    { "type": "uptime", "key": "╰─ 󰔟  Uptime" }
  ]
}
