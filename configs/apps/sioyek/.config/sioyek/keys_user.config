# Fit page width instead of jumping to the top right.
fit_to_page_width zz

# Uppercase J/K scroll half a screen; lowercase j/k move the visual mark.
screen_up J
screen_down K

# >>> sioyek-ecdict >>>
# Managed Sioyek shortcuts.
# [Plugin]
_ecdict s
_ecdict_settings ?
# [Navigation]
goto_toc t
goto_beginning gg
goto_end G
screen_down <space>
screen_up <S-<space>>
prev_state <backspace>
next_state <S-<backspace>>
# [Document]
open_document o
open_prev_doc O
# [Search]
search /
next_item n
previous_item N
# [View]
zoom_in +
zoom_out -
fit_to_page_width =
toggle_dark_mode <f8>
toggle_fullscreen <f11>
# [Annotations]
add_bookmark b
goto_bookmark gb
add_highlight h
goto_highlight gh
# [Other]
copy <C-c>
command :
# <<< sioyek-ecdict <<<
